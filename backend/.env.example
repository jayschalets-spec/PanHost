# Backend configuration
# Copy to .env and fill in real values.

# DATABASE_URL is OPTIONAL. If you leave it unset, the backend runs a real
# PostgreSQL compiled to WASM (PGlite) in-process, persisted to backend/.localdb
# — zero setup, nothing to install. Set it to use a hosted Postgres / Supabase.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_mgmt

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on
PORT=3001

# production | development
NODE_ENV=development

# Set to "disable" to turn off SSL for a remote DB that does not use it.
# PGSSL=disable

# Optional: real partner-API endpoints for live booking sync.
# When unset, /api/sync/* imports sample bookings for demo purposes.
# AIRBNB_SYNC_URL=https://api.example.com/airbnb/reservations
# VRBO_SYNC_URL=https://api.example.com/vrbo/reservations
